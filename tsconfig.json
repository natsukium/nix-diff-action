{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "newLine": "lf",
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "target": "ES2022",
    "outDir": "./dist",
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"],
}
